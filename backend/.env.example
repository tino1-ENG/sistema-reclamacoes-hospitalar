# HospitalCare Backend — Configuração de Ambiente
# Localização: Moçambique (Africa/Maputo)

PORT=5000
NODE_ENV=development

# Ligação à Base de Dados MongoDB Local
DATABASE_URL="mongodb://127.0.0.1:27017/hospitalcare"

# Segredos JWT
JWT_SECRET="hospitalcare_secret_jwt_maputo_central_hospital_2026_super_secure"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="hospitalcare_refresh_secret_key_maputo_2026_super_secure"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Frontend
CORS_ORIGIN="http://localhost:9000"

# Logging (Pino)
LOG_LEVEL="info"
